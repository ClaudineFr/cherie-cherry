# Modèle des variables d'environnement du frontend.
# Copie ce fichier en `.env.local` et adapte les valeurs à ta machine.
# (`.env.local` est ignoré par Git ; ce `.env.example`, lui, est versionné.)

# URL de l'API Django qui fournit les produits.
# En local : l'adresse du serveur `python manage.py runserver`.
API_PRODUCTS_URL=http://127.0.0.1:8000/api/produits/
